# MediaSnap Environment Configuration

# Database: SQLite by default (portable, zero-setup), can be switched to PostgreSQL
DATABASE_URL="file:./dev.db"

# Admin Authentication
JWT_SECRET="mediasnap-super-secure-jwt-secret-key-production-ready-2026"
ADMIN_EMAIL="admin@mediasnap.com"
ADMIN_PASSWORD="Admin@MediaSnap2026!"

# Application Base URL (for canonical URLs, sitemaps, and Open Graph)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional YouTube Data API v3 key (If not provided, MediaSnap uses high-performance oEmbed & direct checks)
YOUTUBE_API_KEY=""

# Security & Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
NODE_ENV="development"
